<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_bottom_sheets">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_set_your_weight"
            android:textColor="@color/yellow_green_text"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_semi_bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnCancel"
            android:layout_marginEnd="10dp"/>

        <RelativeLayout
            android:id="@+id/btnCancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_3rd_grey_border"
            android:layout_alignParentEnd="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_cancel"/>

        </RelativeLayout>

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_track_progress_and_personalize_your_workout_insights"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_regular" />

    <LinearLayout
        android:id="@+id/layoutPickers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginVertical="20dp">

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/npWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:np_width="64dp"
            app:np_height="180dp"
            app:np_dividerColor="@color/transparent"
            app:np_min="30"
            app:np_max="500"
            app:np_value="40"
            app:np_fadingEdgeEnabled="false"
            app:np_textColor="@color/white"
            app:np_selectedTextColor="@color/yellow_green_text"
            app:np_textSize="18dp"
            app:np_selectedTextSize="24dp"
            app:np_wrapSelectorWheel="false"/>

            <TextView
                android:id="@+id/tvDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/outfit_regular"
                android:layout_gravity="center_vertical"/>

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/npPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:np_width="64dp"
            app:np_height="180dp"
            app:np_dividerColor="@color/transparent"
            app:np_min="0"
            app:np_max="9"
            app:np_value="3"
            app:np_fadingEdgeEnabled="false"
            app:np_textColor="@color/white"
            app:np_selectedTextColor="@color/yellow_green_text"
            app:np_textSize="18dp"
            app:np_wrapSelectorWheel="false"
            app:np_selectedTextSize="24dp" />

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/npUnits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:np_width="64dp"
            app:np_height="180dp"
            app:np_dividerColor="@color/transparent"
            app:np_min="0"
            app:np_max="1"
            app:np_value="0"
            app:np_fadingEdgeEnabled="false"
            app:np_textColor="@color/white"
            app:np_selectedTextColor="@color/yellow_green_text"
            app:np_textSize="18dp"
            app:np_selectedTextSize="24dp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_primary"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_save"
            android:textSize="16sp"
            android:layout_centerInParent="true"
            android:fontFamily="@font/outfit_bold"
            android:textColor="@color/white" />

    </RelativeLayout>

</LinearLayout>