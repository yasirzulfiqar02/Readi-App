<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.splashandonboardingscreens.OnBoardingActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:use_controller="false"
        app:resize_mode="zoom"
        android:fitsSystemWindows="false"
        app:keep_content_on_player_reset="true"
        android:layout_marginBottom="1dp"/>

    <View
        android:id="@+id/swipeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomContainer"
        android:background="@color/transparent"/>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/ic_shadow_1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/textViewPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/dotsIndicator"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="center"
            app:dotsClickable="true"
            app:dotsColor="@color/half_transparent_white"
            app:dotsCornerRadius="7dp"
            app:dotsSize="8dp"
            app:dotsSpacing="2dp"
            app:dotsWidthFactor="2.25"
            app:selectedDotColor="@color/white"
            android:layout_marginTop="15dp"/>

        <RelativeLayout
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_become_a_readi_member"
                android:textSize="16sp"
                android:layout_centerInParent="true"
                android:fontFamily="@font/outfit_bold"
                android:textColor="@color/white" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_already_have_an_account"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans_regular" />

            <RelativeLayout
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="-2dp">

                <TextView
                    android:id="@+id/tvSignInTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_sign_in"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="-3dp"
                    android:layout_below="@id/tvSignInTitle"
                    android:layout_alignStart="@id/tvSignInTitle"
                    android:layout_alignEnd="@id/tvSignInTitle"/>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>


