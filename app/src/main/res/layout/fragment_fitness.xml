<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    tools:context=".main.fragments.FitnessFragment">

    <RelativeLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/transparent"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_readi"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_info"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFitnessCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:itemCount="1"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"/>

            <!-- Recommended Program View -->
            <LinearLayout
                android:id="@+id/viewRecommendedProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="20dp">


            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerRecommendedProgram"
                android:layout_width="match_parent"
                android:layout_height="534dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="40dp"
                android:paddingEnd="24dp"/>

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicatorRecommendedProgram"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="center"
                app:dotsClickable="true"
                app:dotsColor="@color/half_transparent_white"
                app:dotsCornerRadius="7dp"
                app:dotsSize="8dp"
                app:dotsSpacing="2dp"
                app:dotsWidthFactor="2.25"
                app:selectedDotColor="@color/white"
                android:layout_marginTop="15dp"/>

            </LinearLayout>

            <!-- All Programs View -->
            <LinearLayout
                android:id="@+id/viewAllPrograms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

            </LinearLayout>

            <!-- On Demand View -->
            <LinearLayout
                android:id="@+id/viewOnDemand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personalized  Readi  fitness"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textAllCaps="true"
                    android:layout_gravity="center"
                    android:letterSpacing="0.04"
                    android:fontFamily="@font/outfit_semi_bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_personalized_training_for_your_readi_fitness_goals"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_what_is_your_focus_today"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="25dp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:fontFamily="@font/outfit_semi_bold" />

                <LinearLayout
                    android:id="@+id/llFocusOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <LinearLayout
                        android:id="@+id/llSpeed"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="34dp"
                        android:background="@drawable/bg_focus_inactive"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_speed"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/outfit_semi_bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llStability"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="34dp"
                        android:background="@drawable/bg_focus_inactive"
                        android:layout_marginHorizontal="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_stability"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/outfit_semi_bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llStrength"
                        android:layout_width="0dp"
                        android:layout_weight="1"                        android:layout_height="wrap_content"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="34dp"
                        android:background="@drawable/bg_focus_inactive"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_strength"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/outfit_semi_bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_how_much_time_do_you_have"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="25dp"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:fontFamily="@font/outfit_semi_bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_what_equipment_are_you_using"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:layout_gravity="center"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04" />

                    <GridLayout
                        android:id="@+id/gridEquipment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout
                            android:id="@+id/llAllEquipment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="6dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_equipment_inactive">

                            <LinearLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_6rd_yellow_green"
                                android:gravity="center">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_all_equipment"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/text_all_equipment"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llBand"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_equipment_inactive">

                            <LinearLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_6rd_yellow_green"
                                android:gravity="center">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_band"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/text_band"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llSingleWeight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="6dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_equipment_inactive">

                            <LinearLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_6rd_yellow_green"
                                android:gravity="center">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_single_weight"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/text_single_weight"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llZero"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_equipment_inactive">

                            <LinearLayout
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_6rd_yellow_green"
                                android:gravity="center">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_zero"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/text_zero"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"/>

                        </LinearLayout>

                    </GridLayout>

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/btnPersonalized"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:padding="16dp"
                    android:layout_marginTop="25dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_personalized_readi_firness"
                        android:textSize="16sp"
                        android:textAllCaps="true"
                        android:layout_centerInParent="true"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Movement Library View -->
            <LinearLayout
                android:id="@+id/viewMovementLibrary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>