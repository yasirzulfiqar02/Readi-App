<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:background="@drawable/bg_screen"
    tools:context=".main.authscreens.SignInActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_marginBottom="20dp"
        android:fitsSystemWindows="true"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <RelativeLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                android:background="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    tools:ignore="UselessParent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_back_arrow"/>

                </RelativeLayout>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_sign_in"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:textSize="24sp"
                android:textAllCaps="true"
                android:fontFamily="@font/outfit_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_get_the_workouts_training_and_discipline_your_strength_and_endurance_need"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular"
                android:layout_marginTop="15dp"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_email_address"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginTop="30dp"/>

            <EditText
                android:id="@+id/editTextTextEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress"
                android:textColorHint="@color/edit_txt_hint"
                android:hint="@string/text_write_email_address"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/outfit_regular"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_txt"
                android:padding="13dp"
                android:textCursorDrawable="@drawable/et_cursor_colour" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_password"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/lato_bold"
                android:layout_marginTop="18dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_txt">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:autofillHints="password"
                    android:hint="@string/text_write_password"
                    android:inputType="textPassword"
                    android:padding="13dp"
                    android:textColorHint="@color/edit_txt_hint"
                    android:textSize="14sp"
                    android:background="@null"
                    android:fontFamily="@font/outfit_regular"
                    android:textColor="@color/white"
                    android:textCursorDrawable="@drawable/et_cursor_colour"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="keyboard_persist"
                    android:layout_gravity="center"
                    android:padding="10dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:src="@drawable/ic_eye_off"
                    android:tint="@color/white" />            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_can_t_remember_your_password"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium" />

                <RelativeLayout
                    android:id="@+id/btnResetIt"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:id="@+id/tvResetIt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:text="@string/text_reset_it"
                        android:textColor="@color/yellow_green"
                        android:textSize="12sp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerInParent="true"/>

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:background="@color/yellow_green"
                        android:layout_marginTop="-2dp"
                        android:layout_below="@id/tvResetIt"
                        android:layout_alignStart="@id/tvResetIt"
                        android:layout_alignEnd="@id/tvResetIt"/>

                </RelativeLayout>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:padding="16dp"
                android:layout_marginTop="25dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_sign_in"
                    android:textSize="16sp"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/outfit_bold"
                    android:textColor="@color/white" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="15dp"
                android:baselineAligned="false"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_white_50rd"
                    android:padding="11dp"
                    android:layout_marginEnd="10dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_apple"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_apple"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_extra_bold"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSignInWithGoogle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_white_50rd"
                    android:padding="11dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_google"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_google"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_extra_bold"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="25dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_don_t_have_an_account"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_medium" />

                <RelativeLayout
                    android:id="@+id/btnSignUP"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:id="@+id/tvSignUpTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_sign_up"
                        android:textColor="@color/yellow_green"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:layout_centerHorizontal="true"
                        android:layout_centerInParent="true"/>

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:layout_marginTop="-3dp"
                        android:background="@color/yellow_green"
                        android:layout_below="@id/tvSignUpTitle"
                        android:layout_alignStart="@id/tvSignUpTitle"
                        android:layout_alignEnd="@id/tvSignUpTitle"/>

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/layout_loading_overlay"/>

</FrameLayout>