<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    tools:context=".main.fragments.CaloriesFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <RelativeLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                android:background="@color/transparent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_toStartOf="@+id/ivProfile"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_health_analysis"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/yellow_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_calories"
                        android:textSize="24sp"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:riv_corner_radius="200dp"
                    app:riv_border_width="1dp"
                    app:riv_border_color="@color/linear_30"
                    android:src="@drawable/ic_profile"
                    android:scaleType="centerCrop"/>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_calculator"
                android:textSize="24sp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit_semi_bold"
                android:textColor="@color/yellow_green_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_estimated_daily_energy_requirement"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_regular"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="20dp"
                android:background="@drawable/divider_olive_gradient" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_personal_details"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:textColor="@color/white"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btnEdit"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_edit"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:textColor="@color/honey_yellow"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="15dp"
                android:background="@drawable/bg_12rd_edit_profile">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_gender"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:textColor="@color/white_60"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/tvMale"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_male"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bottom_nav_top_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_age"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:textColor="@color/white_60"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/tvAge"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/age_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bottom_nav_top_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_height"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:textColor="@color/white_60"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/tvHeight"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bottom_nav_top_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_weight"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:textColor="@color/white_60"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/tvWeight"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bottom_nav_top_border" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_weight"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:textColor="@color/white_60"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/tvActivity"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_low_active"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_12rd_calories_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_estimated_daily_requirement"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:textColor="@color/yellow_green" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_2_350"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:textColor="@color/yellow_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_kcal_day"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:textColor="@color/white_50"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_12rd_calories_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_bmr"
                            android:textAllCaps="true"
                            android:textSize="10sp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/yellow_green"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text__1709"
                            android:textAllCaps="true"
                            android:textSize="18sp"
                            android:layout_marginVertical="5dp"
                            android:fontFamily="@font/outfit_semi_bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_kcal_day"
                            android:textSize="10sp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/white_50"
                            tools:ignore="SmallSp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@drawable/bg_12rd_calories_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_activity"
                            android:textAllCaps="true"
                            android:textSize="10sp"
                            tools:ignore="SmallSp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/yellow_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text__1_550x"
                            android:textAllCaps="true"
                            android:textSize="18sp"
                            android:layout_marginVertical="5dp"
                            android:fontFamily="@font/outfit_semi_bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_multiplier"
                            android:textSize="10sp"
                            tools:ignore="SmallSp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/white_50" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_12rd_calories_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_your_bmi"
                            android:textAllCaps="true"
                            android:textSize="10sp"
                            tools:ignore="SmallSp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/yellow_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text__22_9"
                            android:textAllCaps="true"
                            android:textSize="18sp"
                            android:layout_marginVertical="5dp"
                            android:fontFamily="@font/outfit_semi_bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_normal_weight"
                            android:textSize="10sp"
                            tools:ignore="SmallSp"
                            android:fontFamily="@font/outfit_regular"
                            android:textColor="@color/white_50" />


                    </LinearLayout>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="@drawable/bg_gradient_view" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_based_on_your_profile_28_year_old_male_175_cm_70_kg_moderately_active_your_estimated_daily_calorie_requirement_is_approximately_2_571_kcal_to_maintain_your_current_weight"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_regular"
                    android:textColor="@color/white_60"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>