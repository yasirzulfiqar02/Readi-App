<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheets">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_cancel"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/outfit_regular"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnDone"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_done"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/outfit_regular"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"/>

    </RelativeLayout>

    <com.shawnlin.numberpicker.NumberPicker
        android:id="@+id/npGender"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        app:np_width="64dp"
        app:np_height="180dp"
        app:np_dividerColor="@color/transparent"
        app:np_min="0"
        app:np_max="3"
        app:np_value="2"
        app:np_fadingEdgeEnabled="false"
        app:np_textColor="@color/white"
        app:np_selectedTextColor="@color/yellow_green_text"
        app:np_textSize="18dp"
        app:np_wrapSelectorWheel="false"
        app:np_selectedTextSize="24dp"
        android:layout_gravity="center"
        android:layout_marginVertical="40dp"/>

</LinearLayout>