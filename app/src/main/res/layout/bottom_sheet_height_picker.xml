<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_bottom_sheets">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_set_your_height"
            android:textColor="@color/yellow_green_text"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_semi_bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnCancel"
            android:layout_marginEnd="10dp"/>
        
        <RelativeLayout
            android:id="@+id/btnCancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_3rd_grey_border"
            android:layout_alignParentEnd="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_cancel" />

        </RelativeLayout>

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_we_ll_use_this_to_personalize_your_fitness_stats_and_progress"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_regular" />

    <LinearLayout
        android:id="@+id/layoutPickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="20dp">

        <LinearLayout
            android:id="@+id/feetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/npFeet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:np_width="64dp"
                app:np_height="180dp"
                app:np_min="3"
                app:np_max="8"
                app:np_value="5"
                app:np_dividerColor="@color/transparent"
                app:np_textColor="@color/white"
                app:np_selectedTextColor="@color/yellow_green_text"
                app:np_textSize="18dp"
                app:np_selectedTextSize="24dp"
                app:np_wrapSelectorWheel="false"
                app:np_fadingEdgeEnabled="false"/>

            <TextView
                android:id="@+id/tvDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="10dp" />

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/npInch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:np_width="64dp"
                app:np_height="180dp"
                app:np_min="0"
                app:np_max="11"
                app:np_value="8"
                app:np_dividerColor="@color/transparent"
                app:np_textColor="@color/white"
                app:np_selectedTextColor="@color/yellow_green_text"
                app:np_textSize="18dp"
                app:np_selectedTextSize="24dp"
                app:np_fadingEdgeEnabled="false"
                app:np_wrapSelectorWheel="false" />

        </LinearLayout>

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/npCm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:np_width="64dp"
            app:np_height="180dp"
            app:np_min="98"
            app:np_max="275"
            app:np_value="170"
            app:np_dividerColor="@color/transparent"
            app:np_textColor="@color/white"
            app:np_selectedTextColor="@color/yellow_green_text"
            app:np_textSize="18dp"
            app:np_selectedTextSize="24dp"
            app:np_fadingEdgeEnabled="false" />

        <com.shawnlin.numberpicker.NumberPicker
            android:id="@+id/npUnits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            app:np_width="64dp"
            app:np_height="180dp"
            app:np_min="0"
            app:np_max="1"
            app:np_value="0"
            app:np_dividerColor="@color/transparent"
            app:np_textColor="@color/white"
            app:np_selectedTextColor="@color/yellow_green_text"
            app:np_textSize="18dp"
            app:np_selectedTextSize="24dp"
            app:np_fadingEdgeEnabled="false" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_primary"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_save"
            android:textSize="16sp"
            android:layout_centerInParent="true"
            android:fontFamily="@font/outfit_bold"
            android:textColor="@color/white" />

    </RelativeLayout>

</LinearLayout>