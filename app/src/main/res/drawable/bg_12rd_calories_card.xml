<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F2C94C" />
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:top="2.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.85"
                android:centerY="0.15"
                android:startColor="#45482C"
                android:centerColor="#2E2F26"
                android:endColor="#2E2F26" />
            <corners android:radius="12dp"/>
            <stroke android:width="1dp"
                android:color="@color/yellow_green"/>
        </shape>
    </item>
</layer-list>